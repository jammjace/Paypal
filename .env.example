# Copy to .env.local. All values stay server-side; never use NEXT_PUBLIC_ for secrets.
FINANCIAL_PROVIDER=demo
PAL_DB_PATH=.local/pal.sqlite
# Set true when serving behind HTTPS. Local HTTP preview uses false.
PAL_COOKIE_SECURE=false
# Demo fixtures use this clock, never the host date. Ignored by other providers.
DEMO_AS_OF=2026-10-15T18:00:00.000Z

# Required later, after APIMatic-grounded Sandbox implementation.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Only required if a verified webhook flow is implemented.
PAYPAL_WEBHOOK_ID=

# Free local-only AI. No API key, account, or payment required.
# local = deterministic fallback; ollama = local Qwen3 4B at 127.0.0.1:11434.
PAL_AI_MODE=local
# Run the optional Ollama service with OLLAMA_NO_CLOUD=1; see docs/AI_DESIGN.md.
